# Zepto Shopping Platform Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=1

# Database Configuration
# Local SQLite:
DATABASE_URL=sqlite:///./shopping_platform.db
# Production PostgreSQL:
# DATABASE_URL=postgresql://zepto:zepto_secure_pass@postgres:5432/zepto_db

# Security & Encryption (AES-256 Fernet key for phone & session encryption)
SECRET_KEY=zepto-production-secret-key-at-least-32-chars-long!

# Telegram Bot Token (Obtain from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER

# Zepto Upstream Gateway
ZEPTO_API_BASE=https://bff-gateway.zepto.com
ZEPTO_WEB_BASE=https://www.zepto.com
ENABLE_LIVE_UPSTREAM=0
